# Port exposé sur ta machine pour la gateway Express (point d'entrée unique)
GATEWAY_PORT=3000

# Port exposé sur ta machine pour le service Python (usage direct/debug seulement,
# la gateway ne doit normalement pas être contournée)
PYTHON_PORT=8000

# URL interne utilisée par la gateway pour joindre le service Python.
# "ms-python" est le nom du service dans docker-compose.yml : Docker Compose
# résout ce nom vers l'IP du conteneur automatiquement, pas besoin de "localhost".
PYTHON_SERVICE_URL=http://ms-python:8000
